---
const projects = [
  {
    name: "CustomBotJS",
    link: null,
    github: "https://github.com/danbennettuk/CustomBotJS",
    quote: "",
    description: "A Discord bot for organizing and administering PUBG custom games, automating lobby management and community game coordination."
  },
  {
    name: "hermes-todo",
    link: null,
    github: "https://github.com/danbennettuk/hermes-todo",
    quote: "",
    description: "A shared to-do board for Hermes Desktop and Hermes agents, keeping tasks in sync across tools."
  },
  {
    name: "voice-note-to-midi",
    link: null,
    github: "https://github.com/danbennettuk/voice-note-to-midi",
    quote: "",
    description: "Converts voice notes and humming into quantized MIDI using ML-based pitch detection and intelligent post-processing."
  },
  {
    name: "icloud-calendar-mcp",
    link: null,
    github: "https://github.com/danbennettuk/icloud-calendar-mcp",
    quote: "",
    description: "An MCP server exposing iCloud Calendar over CalDAV, deployed on Vercel."
  },
  {
    name: "raycast-poke",
    link: null,
    github: "https://github.com/danbennettuk/raycast-poke",
    quote: "",
    description: "A Raycast extension for sending messages to Poke directly from the command bar."
  }
];
---

<section class="section projects-section" id="projects">
  <h2 class="section-title">Projects</h2>
  <div class="projects-grid">
    {projects.map((project) => (
      <div class="project-card">
        <div class="project-name">{project.name}</div>
        {project.quote && (
          <div class="project-quote">{project.quote}</div>
        )}
        <div class="project-description">
          <p>{project.description}</p>
        </div>
        <div class="project-links">
          {project.link && (
            <a href={project.link} class="project-link" target="_blank" rel="noopener noreferrer">View →</a>
          )}
          {project.github && (
            <a href={project.github} class="project-link" target="_blank" rel="noopener noreferrer">GitHub →</a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>