---
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Dan Bennett — Creator Partnerships and Community Operations">
  <div class="site-shell" id="top">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Dan Bennett home">Dan Bennett</a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="mailto:dan@danbennett.me">Email</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy">
          <p class="eyebrow">Creator partnerships · Community operations · Gaming</p>
          <h1 id="intro-title">Dan<br /><em>Bennett</em></h1>
          <p class="hero-lede">I work with creators, communities and teams to make programmes and player experiences work better.</p>
          <p class="availability">Currently Associate Creator Partnerships Manager, PUBG West at KRAFTON.</p>
        </div>
        <div class="hero-detail" aria-hidden="true">
          <div class="ambient-mark"><span></span></div>
          <p>Newport, South Wales<br />Working globally</p>
        </div>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="section-label"><span>01</span><span>About</span></div>
        <div class="section-body about-copy">
          <h2 id="about-title">A practical, people-first approach to community and creator work.</h2>
          <p>I am a creator partnerships and community operations professional working in gaming, currently supporting the PUBG Partner Program on PUBG: Battlegrounds at KRAFTON.</p>
          <p>My work includes creator relationships, campaign operations, community feedback and performance reporting. I enjoy turning messy, manual processes into clear workflows that help teams support creators, learn from their feedback and make better decisions.</p>
          <p>I also bring hands-on experience running gaming communities, events and tournaments.</p>
        </div>
      </section>

      <section class="section experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-label"><span>02</span><span>Experience</span></div>
        <div class="section-body"><h2 id="experience-title" class="visually-hidden">Professional Experience</h2><Experience /></div>
      </section>

      <section class="section contact-section" aria-labelledby="contact-title">
        <div class="section-label"><span>03</span><span>Contact</span></div>
        <div class="section-body contact-copy">
          <h2 id="contact-title">Get in touch.</h2>
          <a class="email-link" href="mailto:dan@danbennett.me">dan@danbennett.me <span aria-hidden="true">↗</span></a>
          <div class="social-list" aria-label="Social links">
            <a href="https://www.linkedin.com/in/danbennettuk" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://github.com/danbennettuk" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://twitter.com/danbennett" target="_blank" rel="noopener noreferrer">Twitter</a>
            <a href="https://www.instagram.com/danbennettuk" target="_blank" rel="noopener noreferrer">Instagram</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  import * as THREE from 'https://unpkg.com/three@0.161.0/build/three.module.js';
  const mark = document.querySelector('.ambient-mark');
  if (mark && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    mark.append(canvas);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 10); camera.position.z = 3.4;
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5)); renderer.setSize(180, 180, false);
    const mesh = new THREE.Mesh(new THREE.IcosahedronGeometry(0.9, 1), new THREE.MeshBasicMaterial({ color: 0x9b3d2d, wireframe: true, transparent: true, opacity: 0.28 }));
    scene.add(mesh);
    let frame = 0;
    const animate = () => { frame = requestAnimationFrame(animate); mesh.rotation.y += 0.002; mesh.rotation.x += 0.0005; renderer.render(scene, camera); };
    animate();
    document.addEventListener('visibilitychange', () => { if (document.hidden) cancelAnimationFrame(frame); else animate(); });
  }
</script>
