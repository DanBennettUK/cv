---
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Dan Bennett — Creator Partnerships & Community Operations Professional">
  <div class="site-shell">
    <header class="topbar">
      <a class="wordmark" href="#top" aria-label="Dan Bennett home">Dan Bennett</a>
      <nav class="topnav" aria-label="Primary navigation">
        <a href="#about">About</a><a href="#experience">Experience</a>
      </nav>
      <a class="top-contact" href="mailto:dan@danbennett.me">dan@danbennett.me</a>
    </header>

    <main id="top">
      <section class="hero" id="about" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">Creator partnerships · Community operations</p>
          <h1 id="page-title">Dan<br /><span>Bennett</span></h1>
          <p class="hero-lede">Creator Partnerships and Community Operations Professional in Gaming.</p>
          <div class="hero-links">
            <a class="text-link" href="mailto:dan@danbennett.me">Email Dan <span aria-hidden="true">↗</span></a>
            <a class="text-link muted-link" href="#experience">View experience <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <aside class="hero-meta" aria-label="Contact details">
          <img class="hero-image" src="/dan.jpg" alt="Dan Bennett" width="128" height="128" />
          <dl>
            <div><dt>Currently</dt><dd>Associate Creator Partnerships Manager<br />KRAFTON · PUBG West</dd></div>
            <div><dt>Email</dt><dd><a href="mailto:dan@danbennett.me">dan@danbennett.me</a></dd></div>
            <div><dt>Web</dt><dd><a href="https://danbennett.me">danbennett.me</a></dd></div>
          </dl>
        </aside>
      </section>

      <section class="intro section-pad" aria-labelledby="about-title">
        <p class="section-kicker">01 / About</p>
        <div class="intro-copy">
          <h2 id="about-title">Creator relationships, campaign operations and community feedback.</h2>
          <p>I am a creator partnerships and community operations professional working in gaming, currently supporting the PUBG Partner Program on PUBG: Battlegrounds at KRAFTON.</p>
          <p>My work sits at the intersection of creator relationships, campaign operations, community feedback and performance reporting. I enjoy turning messy, manual processes into clear workflows that help teams support creators, learn from their feedback and make better decisions.</p>
          <p>I also bring hands-on community experience from running gaming communities, events and tournaments. I care about making the experience better for both the people creating content and the players watching it.</p>
        </div>
      </section>

      <div class="section-pad"><Experience /></div>
      <section class="contact section-pad" aria-labelledby="contact-title">
        <p class="section-kicker">02 / Contact</p>
        <div><h2 id="contact-title">Let’s talk.</h2><a class="text-link" href="mailto:dan@danbennett.me">dan@danbennett.me <span aria-hidden="true">↗</span></a></div>
      </section>
      <Footer />
    </main>
  </div>
</BaseLayout>

<canvas id="quiet-orb" aria-hidden="true"></canvas>

<script>
  import * as THREE from 'https://unpkg.com/three@0.161.0/build/three.module.js';
  const canvas = document.querySelector('#quiet-orb');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduceMotion) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 20); camera.position.z = 4;
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
    const group = new THREE.Group(); scene.add(group);
    const geometry = new THREE.IcosahedronGeometry(1.25, 2);
    group.add(new THREE.LineSegments(new THREE.WireframeGeometry(geometry), new THREE.LineBasicMaterial({ color: 0x4d83b8, transparent: true, opacity: 0.13 })));
    const resize = () => { const size = Math.min(360, innerWidth * .34); renderer.setSize(size, size, false); };
    resize(); addEventListener('resize', resize);
    const animate = () => { group.rotation.y += .0008; group.rotation.x += .00025; renderer.render(scene, camera); requestAnimationFrame(animate); }; animate();
  }
</script>
